{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lineamiento.schema.json",
  "title": "Lineamiento",
  "description": "A standard, policy or working rule currently in force",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "by",
        "at"
      ]
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "stale_after": {
      "type": "string",
      "format": "date-time"
    },
    "resumen": {
      "type": "string"
    },
    "resumen_hash": {
      "type": "string"
    },
    "procedencia": {
      "type": "string",
      "enum": [
        "fuente",
        "dialogo",
        "inferido",
        "manual",
        "derivado"
      ]
    },
    "area": {
      "type": "string"
    },
    "fuente": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "vigente",
        "en-revision"
      ]
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "valido_desde": {
      "type": "string",
      "format": "date"
    },
    "valido_hasta": {
      "type": "string",
      "format": "date"
    },
    "reemplazada_por": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "description",
    "tags",
    "classification",
    "generated",
    "resumen",
    "resumen_hash",
    "procedencia",
    "area",
    "fuente",
    "estado"
  ]
}
