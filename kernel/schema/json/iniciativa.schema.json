{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iniciativa.schema.json",
  "title": "Iniciativa",
  "description": "The CONTEXT.md of each project or objective with an identity of its own",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "by",
        "at"
      ]
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "stale_after": {
      "type": "string",
      "format": "date-time"
    },
    "proyecto": {
      "type": "string"
    },
    "origen": {
      "type": "string",
      "enum": [
        "proyecto-asignado",
        "objetivo-personal",
        "objetivo-equipo"
      ]
    },
    "periodo": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "iniciando",
        "en-progreso",
        "bloqueada",
        "entregada"
      ]
    },
    "sistemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type",
    "title",
    "description",
    "tags",
    "classification",
    "generated",
    "proyecto",
    "origen",
    "periodo",
    "estado"
  ]
}
