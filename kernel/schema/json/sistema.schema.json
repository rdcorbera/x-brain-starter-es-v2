{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sistema.schema.json",
  "title": "Sistema",
  "description": "Profile of a system, tool, product or process of the organization",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "by",
        "at"
      ]
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "stale_after": {
      "type": "string",
      "format": "date-time"
    },
    "dueño": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "sistema",
        "herramienta",
        "producto",
        "proceso"
      ]
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "en-cambio",
        "deprecado"
      ]
    }
  },
  "required": [
    "type",
    "title",
    "description",
    "tags",
    "classification",
    "generated",
    "dueño",
    "categoria",
    "estado"
  ]
}
