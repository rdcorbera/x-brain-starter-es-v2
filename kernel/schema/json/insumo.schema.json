{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insumo.schema.json",
  "title": "Insumo",
  "description": "A received document converted to markdown, pointing at its original in /raw/",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "by",
        "at"
      ]
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "stale_after": {
      "type": "string",
      "format": "date-time"
    },
    "proyecto": {
      "type": "string"
    },
    "formato": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "pptx",
        "xlsx",
        "html",
        "yaml"
      ]
    },
    "origen": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "description",
    "tags",
    "classification",
    "generated",
    "proyecto",
    "formato",
    "origen"
  ]
}
