{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Plan",
  "description": "The PLAN.md of a project: the tasks that lead to \"delivered\", grouped by phase",
  "type": "object",
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "generated": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "by",
        "at"
      ]
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "stale_after": {
      "type": "string",
      "format": "date-time"
    },
    "resumen": {
      "type": "string"
    },
    "resumen_hash": {
      "type": "string"
    },
    "procedencia": {
      "type": "string",
      "enum": [
        "fuente",
        "dialogo",
        "inferido",
        "manual",
        "derivado"
      ]
    },
    "proyecto": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "string",
      "enum": [
        "cerebro",
        "externa"
      ]
    },
    "external_tracker": {
      "type": "string"
    },
    "last_review": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "type",
    "title",
    "description",
    "tags",
    "classification",
    "generated",
    "resumen",
    "resumen_hash",
    "procedencia",
    "proyecto",
    "source_of_truth",
    "last_review"
  ]
}
